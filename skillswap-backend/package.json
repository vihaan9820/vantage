{
  "name": "skillswap-backend",
  "version": "1.0.0",
  "description": "SkillSwap Backend API - Payment & Verification Server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
